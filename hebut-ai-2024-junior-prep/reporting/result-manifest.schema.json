{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hebut-ai/result-manifest.schema.json",
  "title": "HEBUT AI Experiment Result Manifest",
  "type": "object",
  "required": [
    "meta",
    "environment",
    "data",
    "methodology",
    "parameters",
    "metrics",
    "tables",
    "figures",
    "artifacts",
    "commands",
    "findings",
    "problems",
    "conclusion"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["course", "experiment", "contract"],
      "properties": {
        "course": {"type": "string", "minLength": 1},
        "experiment": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1},
        "student": {"type": "string"},
        "student_id": {"type": "string"},
        "class_name": {"type": "string"},
        "date": {"type": "string"},
        "git_commit": {"type": "string"}
      }
    },
    "purpose": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "data": {"type": "array", "items": {"type": "object"}},
    "methodology": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parameters": {"type": "array", "items": {"type": "object"}},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "value", "source"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "value": {"type": "number"},
          "source": {"type": "string"}
        }
      }
    },
    "tables": {"$ref": "#/$defs/pathItems"},
    "figures": {"$ref": "#/$defs/pathItems"},
    "artifacts": {"$ref": "#/$defs/pathItems"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {"command": {"type": "string", "minLength": 1}}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "problems": {"type": "array"},
    "conclusion": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "pathItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
